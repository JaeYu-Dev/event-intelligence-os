{
  "name": "event-intelligence-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "api": "cd apps/api && uvicorn api.main:app --reload --host 0.0.0.0 --port 8000",
    "worker": "cd apps/api && celery -A worker.main worker -l info",
    "db:upgrade": "cd apps/api && alembic upgrade head",
    "db:migrate": "cd apps/api && alembic revision --autogenerate -m"
  },
  "devDependencies": {}
}
