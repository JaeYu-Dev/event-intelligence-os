# Database
DATABASE_URL=postgresql://eios:eios@localhost:5432/eios

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=eios
S3_SECRET_KEY=eioseios
S3_BUCKET=eios-raw

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# SEC EDGAR
SEC_USER_AGENT="EventIntelligenceOS contact@yourdomain.com"

# Safety
ENABLE_LIVE_TRADING=false
ALLOW_AUTONOMOUS_ORDERS=false
DEFAULT_MODE=paper
MIN_EVIDENCE_GRADE_FOR_TRADE=E2
REQUIRE_HUMAN_APPROVAL=true
MAX_LLM_CALLS_PER_THESIS_PER_DAY=3
